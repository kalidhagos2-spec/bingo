PORT=3000

# PostgreSQL connection string. Shared with the bot (see bot/.env.example) — both
# services connect to the same database, each managing its own tables.
# Local dev: docker compose up postgres, or run PostgreSQL yourself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgbingo

# Max connections in this service's Postgres pool (default 10). The bot has its own,
# separate pool (see bot/.env.example) -- both share the database's total connection
# limit, so size this to your actual traffic and your Postgres provider's connection cap.
# PGPOOL_MAX=10

# Same token as the bot. Used to verify Telegram Mini App initData.
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# --- Cross-origin webapp (free-tier hosting) ---
# Leave empty for the docker-compose setup: nginx reverse-proxies /api and /socket.io to
# this server on the same origin, so browsers don't apply CORS at all. Set this (comma-
# separated) when the webapp is deployed on a *different* origin -- e.g. the webapp on
# Vercel and this server on Render. Must match the webapp's real deployed origin(s) exactly,
# and the webapp must be built with VITE_API_URL pointing at this server (see
# webapp/.env.example).
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Public HTTPS origin of the Mini App (ngrok / Vercel). Payment return + webhook
# URLs are built from this: <PUBLIC_URL>/api/payments/...
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Multiplayer room rules
MIN_PLAYERS=2
MAX_PLAYERS=8
# BINGO! wins with a complete row, column or diagonal (LINES_TO_WIN of them) or all four
# corners. Set FULL_CARD=true to require every number on the card instead.
FULL_CARD=false
LINES_TO_WIN=1
CALL_INTERVAL_MS=4000
# Time players get to pick a cartela once enough have joined (40 seconds)
COUNTDOWN_MS=40000
RESTART_DELAY_MS=8000
# Numbered cartelas (fixed cards) players pick from before each round
CARTELA_COUNT=400
# Cartelas one player may hold per round (each one pays the stake)
MAX_CARTELAS=4
# Public tables in the lobby, by stake in ETB (0 = free table)
STAKES=10,20,50
# Share of every player's stake kept by the house (the house hosts all tables);
# the rest of the stakes is the winner's prize pool
HOUSE_CUT_PERCENT=20
# Ceiling on any round's prize (the lobby advertises "Prize up to" this amount)
MAX_PRIZE=3000
# Token for the operator endpoints (/api/admin/house, header x-admin-token)
ADMIN_TOKEN=
# Coins (soft currency) paid to the winner of a Free Bingo round
FREE_BINGO_COINS=50

# Top-up limits in ETB
MIN_TOPUP=10
MAX_TOPUP=5000
# Share of every wallet top-up kept by the house (the player is credited the rest)
DEPOSIT_FEE_PERCENT=0
# House accounts for "transfer and paste the receipt id" deposits (leave empty to hide a method).
# Editable later from the admin dashboard Settings tab. Several accounts per method are
# allowed as comma-separated lists, names paired by position:
#   HOUSE_TELEBIRR_ACCOUNT=0911111111,0922222222
#   HOUSE_TELEBIRR_NAME=Shitaye,Gelaw
# Demo values below — replace with your real merchant / bank accounts before going live.
HOUSE_TELEBIRR_ACCOUNT=0900000000
HOUSE_TELEBIRR_NAME=Demo Bingo (test)
HOUSE_CBEBIRR_ACCOUNT=
HOUSE_CBEBIRR_NAME=
HOUSE_BOA_ACCOUNT=
HOUSE_BOA_NAME=
# Cash-outs are paid by the operator from this house account (shown to players and in the dashboard).
# PAYOUT_METHOD limits the rail players can be paid on (empty = any).
PAYOUT_METHOD=telebirr
PAYOUT_ACCOUNT=0900000000
PAYOUT_NAME=Demo Bingo (test)
# Cash-out limits in ETB and the share kept by the house (0 = no fee)
MIN_WITHDRAW=50
MAX_WITHDRAW=5000
WITHDRAW_FEE_PERCENT=2

# Who sends an approved cash-out (Admin > Withdrawals > Approve):
#   none     the operator pays by hand from PAYOUT_ACCOUNT and types the Telebirr receipt id (default)
#   sandbox  simulated: the whole flow runs, NO MONEY MOVES (for rehearsals; the dashboard says so)
#   chapa    Chapa Transfers to Telebirr wallets and bank accounts (needs CHAPA_SECRET_KEY below;
#            point Chapa's payout webhook at <PUBLIC_URL>/api/payments/payout-webhook/chapa)
#   telebirr the unverified Telebirr B2C stub (needs TELEBIRR_B2C_URL + merchant credentials)
PAYOUT_PROVIDER=none
# Largest cash-out the gateway sends on one click; above it the operator must confirm (editable in the dashboard)
MAX_AUTO_PAYOUT=2000
# A sent cash-out is asked about every PAYOUT_CHECK_MS until paid/failed; flagged for a person after PAYOUT_GIVE_UP_HOURS
PAYOUT_CHECK_MS=60000
PAYOUT_GIVE_UP_HOURS=48
# Sandbox only: default outcome (success | failed | pending), how long a transfer takes, and the
# secret for curl-ing POST /api/payments/payout-webhook/sandbox {ref, status} (header x-sandbox-secret).
# The last two digits of the account pick the outcome: ..99 fails, ..98 never answers, ..97 the send
# times out then turns out paid, ..96 "transfer hours" (back to pending), ..95 invalid account.
PAYOUT_SANDBOX_OUTCOME=success
PAYOUT_SANDBOX_DELAY_MS=15000
PAYOUT_SANDBOX_WEBHOOK_SECRET=

# Pending Telebirr deposits are re-checked against the public receipt this often (ms) and for this long (hours)
RECEIPT_RECHECK_MS=180000
RECEIPT_RECHECK_HOURS=24
# Telebirr disbursement (B2C) endpoint from your merchant contract; empty = cash-outs paid by hand and confirmed by receipt id
TELEBIRR_B2C_URL=
# TEST ONLY: credit every transfer+receipt deposit at once without checking the receipt
AUTO_APPROVE_DEPOSITS=false
# Smallest in-game transfer between players (ETB)
MIN_TRANSFER=5
# Allow unauthenticated requests as a dev user (auto-enabled when BOT_TOKEN is unset).
DEV_ALLOW_ANON=false

# --- Telebirr (Ethio Telecom mobile money) Web API merchant credentials ---
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_RECEIVE_NAME=Telegram Bingo
TELEBIRR_BASE_URL=https://app.ethiomobilemoney.et:2121

# --- Chapa (aggregator used for CBE Birr and Bank of Abyssinia checkout) ---
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co
# Payouts: Chapa bank ids (GET /v1/banks) per rail; empty = found by name at run time
CHAPA_BANK_CODE_TELEBIRR=
CHAPA_BANK_CODE_CBEBIRR=
CHAPA_BANK_CODE_BOA=

# Demo players: house bots with random names and play-money wallets that join the public
# tables and play like people (pick cartelas, mark, call BINGO). 0 = off. Meant for demos and
# quiet hours. A real player never loses money to one: when a demo player wins a paid round,
# the real players' stakes for that round are refunded. A real player CAN win the pool the
# demo players paid into, and the house pays that difference, so keep this low or off once
# real money is live. They are tagged DEMO in the operator dashboard.
DEMO_BOTS=0
# DEMO_BOTS, DEMO_BOTS_PER_ROOM and DEMO_BOTS_SHARE are only the defaults: the operator changes
# them live in the dashboard (Settings > Demo players). Each also takes per-table values, e.g.
# DEMO_BOTS_PER_ROOM=10=50,20=40,50=30 or DEMO_BOTS_SHARE=10=0.5,50=0.9.
# A range works too: DEMO_BOTS=20-30 keeps between 20 and 30 of them around, re-rolled at random
# every few minutes, like a real crowd. DEMO_BOTS_PER_ROOM caps how many sit at one table.
DEMO_BOTS_MIN_BALANCE=50
DEMO_BOTS_MAX_BALANCE=500
DEMO_BOTS_PER_ROOM=3
# DEMO_BOTS_PER_ROOM is the size a table is filled to, real players included (30 = "30 players per
# game"). A range, e.g. 20-30, gives every table its own random size in it, drawn anew each
# round. Use DEMO_BOTS of about (number of stakes + 1) x the larger number, and MAX_PLAYERS a
# few above it.
# Share of the cartelas demo players aim to hold at a table with real players: 0.9 = nine for
# every one of theirs, so a demo player wins about nine rounds in ten there. It works only
# through how many cartelas they buy: the draw, the marks and the BINGO check are never touched,
# every cartela has the same chance, and a real player's stake is still refunded when a demo
# player wins. 0 = off (demo players pick 1-3 cartelas whoever is at the table).
DEMO_BOTS_SHARE=0
