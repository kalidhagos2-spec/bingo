PORT=3000

# PostgreSQL connection string. Shared with the bot (see bot/.env.example) — both
# services connect to the same database, each managing its own tables.
# Local dev: docker compose up postgres, or run PostgreSQL yourself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgbingo

# Max connections in this service's Postgres pool (default 10). The bot has its own,
# separate pool (see bot/.env.example) -- both share the database's total connection
# limit, so size this to your actual traffic and your Postgres provider's connection cap.
# PGPOOL_MAX=10

# Same token as the bot. Used to verify Telegram Mini App initData.
BOT_TOKEN=123456789:replace-with-the-token-from-BotFather

# --- Cross-origin webapp (free-tier hosting) ---
# Leave empty for the docker-compose setup: nginx reverse-proxies /api and /socket.io to
# this server on the same origin, so browsers don't apply CORS at all. Set this (comma-
# separated) when the webapp is deployed on a *different* origin -- e.g. the webapp on
# Vercel and this server on Render. Must match the webapp's real deployed origin(s) exactly,
# and the webapp must be built with VITE_API_URL pointing at this server (see
# webapp/.env.example).
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Public HTTPS origin of the Mini App (ngrok / Vercel). Payment return + webhook
# URLs are built from this: <PUBLIC_URL>/api/payments/...
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Multiplayer room rules
MIN_PLAYERS=2
MAX_PLAYERS=8
# The round ends when a player has marked every number on their card. Set to false
# to end it after LINES_TO_WIN completed lines instead.
FULL_CARD=true
LINES_TO_WIN=1
CALL_INTERVAL_MS=4000
# Time players get to pick a cartela once enough have joined (40 seconds)
COUNTDOWN_MS=40000
RESTART_DELAY_MS=8000
# Numbered cartelas (fixed cards) players pick from before each round
CARTELA_COUNT=100
# Public tables in the lobby, by stake in ETB (0 = free table)
STAKES=0,10,20,50
# Share of every player's stake kept by the house (the house hosts all tables);
# the rest of the stakes is the winner's prize pool
HOUSE_CUT_PERCENT=2
# Token for the operator endpoints (/api/admin/house, header x-admin-token)
ADMIN_TOKEN=
# Coins (soft currency) paid to the winner of a Free Bingo round
FREE_BINGO_COINS=50

# Top-up limits in ETB
MIN_TOPUP=10
MAX_TOPUP=5000
# Share of every wallet top-up kept by the house (the player is credited the rest)
DEPOSIT_FEE_PERCENT=2
# House accounts for "transfer and paste the receipt id" deposits (leave empty to hide a method).
# Editable later from the admin dashboard Settings tab.
# Demo values below — replace with your real merchant / bank accounts before going live.
HOUSE_TELEBIRR_ACCOUNT=0900000000
HOUSE_TELEBIRR_NAME=Demo Bingo (test)
HOUSE_CBEBIRR_ACCOUNT=
HOUSE_CBEBIRR_NAME=
HOUSE_BOA_ACCOUNT=
HOUSE_BOA_NAME=
# Cash-out limits in ETB and the share kept by the house (0 = no fee)
MIN_WITHDRAW=50
MAX_WITHDRAW=5000
WITHDRAW_FEE_PERCENT=0

# Force the built-in mock gateway (also used automatically when no real
# gateway below is configured).
PAYMENTS_MOCK=false
# Allow unauthenticated requests as a dev user (auto-enabled when BOT_TOKEN is unset).
DEV_ALLOW_ANON=false

# --- Email login (players outside Telegram get a one-time code by email) ---
# nodemailer connection URL, e.g. smtps://user:pass@smtp.gmail.com:465
# Leave empty to print codes to the server log (dev mode also returns them to the app).
SMTP_URL=
MAIL_FROM=Telegram Bingo <no-reply@example.com>

# --- Telebirr (Ethio Telecom mobile money) Web API merchant credentials ---
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_RECEIVE_NAME=Telegram Bingo
TELEBIRR_BASE_URL=https://app.ethiomobilemoney.et:2121

# --- Chapa (aggregator used for CBE Birr and Bank of Abyssinia checkout) ---
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co
