# One image for a single-service deploy (Render, Fly, a small VPS): the game server with the
# built Mini App inside it, served from the same origin. docker-compose does not use this file:
# locally nginx serves the web app and proxies /api and /socket.io (see webapp/Dockerfile).
#
# Build context: the repository root.   docker build -f Dockerfile.render -t usabingo .

FROM node:22-alpine AS webapp
WORKDIR /build
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
# Same origin as the API: no VITE_API_URL, so the app calls /api and /socket.io relatively.
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production WEBAPP_DIR=/app/public
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev
COPY server/src ./src
COPY --from=webapp /build/dist ./public
RUN chown -R node:node /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/api/health" >/dev/null || exit 1
CMD ["node", "src/index.js"]
