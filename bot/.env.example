# Token from @BotFather (never commit the real one; rotate it if it was ever pasted anywhere)
BOT_TOKEN=8586811375:AAH7FNzs8Ey0-pb6DHjYpMA67cqdQJ_fCGg

# Public HTTPS URL of the Mini App (Telegram requires HTTPS).
# Local dev: run `ngrok http 5173` (or 8080 for docker) and paste the https URL here.
WEBAPP_URL=http://localhost:8080/

# Game server the bot pushes sign-up profiles to (docker-compose sets http://server:3000 itself).
API_URL=http://127.0.0.1:3000

# Postgres (docker-compose sets its own value; needed for `npm run dev` outside docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tgbingo

# Optional: public HTTPS base URL of the bot itself. When set, the bot receives Telegram
# updates by webhook at <WEBHOOK_URL>/telegram/<secret> instead of long-polling. Render sets
# RENDER_EXTERNAL_URL automatically, which is used as a fallback.
# WEBHOOK_URL=https://bot.your-domain.example.com

# Shown by /contact (Telegram usernames, with or without the @). Leave empty until they exist.
SUPPORT_USERNAME=
CHANNEL_USERNAME=

# The bot sets its own "/" command menu, description and about text at start-up (Amharic, see
# BOT_PROFILE in src/i18n.js). Set to false to keep what you typed into BotFather by hand.
BOT_APPLY_PROFILE=true
